# PostgreSQL
DB_NAME=journey_db
DB_USERNAME=journey
DB_PASSWORD=change-this-database-password

# Spring Boot
FLYWAY_ENABLED=true
HIBERNATE_SHOW_SQL=false

# JWT: 실제 운영에서는 길고 무작위인 값으로 변경
JWT_SECRET=change-this-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_MINUTES=120
JWT_REFRESH_TOKEN_DAYS=30

# 현재 IP로 접속하는 경우
CORS_ALLOWED_ORIGINS=http://43.201.163.120

# Google API
GOOGLE_API_KEY=replace-with-google-api-key
GOOGLE_AI_API_KEY=replace-with-google-ai-api-key

# AI 기능
SPRING_AI_CHAT_MODEL=google-genai
JC_AI_CONTENT_ANALYSIS_ENABLED=false
JC_AI_CONTENT_MODEL=gemini-3.6-flash
JC_AI_CONTENT_TEMPERATURE=0.1

# 추천 기능
RECOMMENDATION_MODE=OFF
RECOMMENDATION_P1_MODE=OFF
RECOMMENDATION_P2_ASSIGNMENT_ENABLED=false
RECOMMENDATION_CANDIDATE_LIMIT=100
RECOMMENDATION_REPLAY_AUDIT_ENABLED=true

# 탐색 추천
JC_EXPLORE_MODE=LEGACY
JC_EXPLORE_CURSOR_SECRET=change-this-to-another-long-random-secret