spring:
  application:
    name: jc-backend
  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:journey_db}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:여기에비밀번호입력}
    driver-class-name: org.postgresql.Driver
  flyway:
    enabled: ${FLYWAY_ENABLED:true}
    locations: classpath:db/migration
  jpa:
    hibernate:
      ddl-auto: validate
    properties:
      hibernate:
        show_sql: ${HIBERNATE_SHOW_SQL:false}
        format_sql: true
        jdbc:
          time_zone: UTC
    open-in-view: false
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 50MB
  ai:
    model:
      chat: ${SPRING_AI_CHAT_MODEL:google-genai}
    google:
      genai:
        api-key: ${GOOGLE_AI_API_KEY:여기에구글API키입력}
        chat:
          options:
            model: ${JC_AI_CONTENT_MODEL:gemini-3.6-flash}
            temperature: ${JC_AI_CONTENT_TEMPERATURE:0.1}

server:
  port: ${SERVER_PORT:8080}

app:
  intelligence:
    content-analysis:
      enabled: ${JC_AI_CONTENT_ANALYSIS_ENABLED:true}
      model-version: ${JC_AI_CONTENT_MODEL:gemini-3.6-flash}
  security:
    jwt-secret: ${JWT_SECRET:journey-connect-local-dev-secret-32bytes}
    access-token-minutes: ${JWT_ACCESS_TOKEN_MINUTES:120}
    refresh-token-days: ${JWT_REFRESH_TOKEN_DAYS:30}
    password-reset-minutes: ${PASSWORD_RESET_MINUTES:30}
    password-reset-base-url: ${PASSWORD_RESET_BASE_URL:http://localhost:5173/reset-password}
    password-reset-mail-from: ${PASSWORD_RESET_MAIL_FROM:no-reply@journey-connect.local}
    password-reset-expose-token: ${PASSWORD_RESET_EXPOSE_TOKEN:false}
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}
  google:
    api-key: ${GOOGLE_API_KEY:여기에구글API키입력}
  upload:
    directory: ${UPLOAD_DIR:./uploads/images}
  recommendation:
    mode: ${RECOMMENDATION_MODE:OFF}
    candidate-limit: ${RECOMMENDATION_CANDIDATE_LIMIT:100}
    core-build-id: ${RECOMMENDATION_CORE_BUILD_ID:java-core-1.2.0}
    replay-audit-enabled: ${RECOMMENDATION_REPLAY_AUDIT_ENABLED:true}
    replay-evaluator-version: ${RECOMMENDATION_REPLAY_EVALUATOR_VERSION:p0-persistence-replay-v1}
    readiness-minimum-shadow-runs: ${RECOMMENDATION_READINESS_MINIMUM_SHADOW_RUNS:20}
    readiness-lookback-runs: ${RECOMMENDATION_READINESS_LOOKBACK_RUNS:100}
    readiness-max-p95-duration-ms: ${RECOMMENDATION_READINESS_MAX_P95_DURATION_MS:1000}
    canary-allocation-basis-points: ${RECOMMENDATION_CANARY_ALLOCATION_BPS:0}
    canary-cursor-secret: ${RECOMMENDATION_CANARY_CURSOR_SECRET:}
    canary-release-id: ${RECOMMENDATION_CANARY_RELEASE_ID:}
    explore:
      mode: ${JC_EXPLORE_MODE:LEGACY}
      cursor-secret: ${JC_EXPLORE_CURSOR_SECRET:journey-connect-explore-local-dev-secret-32bytes}
    p1:
      mode: ${RECOMMENDATION_P1_MODE:OFF}
    p2:
      assignment-enabled: ${RECOMMENDATION_P2_ASSIGNMENT_ENABLED:false}

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    groups-order: ASC
    tags-sorter: alpha
    operations-sorter: alpha
    display-request-duration: true
