spring:
  application:
    name: jc-backend
  datasource:
    url: jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:5432}/${DB_NAME:journey_db}
    username: ${DB_USERNAME:postgres}
    password: ${DB_PASSWORD:여기에비밀번호입력}
    driver-class-name: org.postgresql.Driver
  jpa:
    hibernate:
      ddl-auto: update
    properties:
      hibernate:
        show_sql: true
        format_sql: true
        dialects:
          spatial: org.hibernate.spatial.dialect.postgis.PostgisDialect
    open-in-view: false
  servlet:
    multipart:
      max-file-size: 5MB
      max-request-size: 50MB

server:
  port: ${SERVER_PORT:8080}

app:
  security:
    jwt-secret: ${JWT_SECRET:journey-connect-local-dev-secret-32bytes}
    access-token-minutes: ${JWT_ACCESS_TOKEN_MINUTES:120}
    refresh-token-days: ${JWT_REFRESH_TOKEN_DAYS:30}
  cors:
    allowed-origins: ${CORS_ALLOWED_ORIGINS:http://localhost:5173}
  google:
    api-key: ${GOOGLE_API_KEY:여기에구글API키입력}
  upload:
    # 운영 환경에서는 애플리케이션 폴더 밖의 영구 디스크 경로를 UPLOAD_DIR로 지정하세요.
    directory: ${UPLOAD_DIR:./uploads/images}

springdoc:
  api-docs:
    path: /api-docs
  swagger-ui:
    path: /swagger-ui.html
    groups-order: ASC
    tags-sorter: alpha
    operations-sorter: alpha
    display-request-duration: true
